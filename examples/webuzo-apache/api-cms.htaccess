# Place this file at: public_html/api/cms/.htaccess

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Optional: hide .php extension
    # RewriteRule ^content$ receive-cms-content.php [L,QSA]
</IfModule>

# JSON POST bodies can be large when articles include embedded images.
<IfModule mod_php.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
    php_value memory_limit 256M
    php_value max_execution_time 120
</IfModule>

<IfModule mod_php8.c>
    php_value upload_max_filesize 32M
    php_value post_max_size 32M
    php_value memory_limit 256M
    php_value max_execution_time 120
</IfModule>
